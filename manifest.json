{
    "name": "Selected Text Viewer",
    "version": "1.1",
    "description": "Right-click selected text to show it in a popup window.",
    "manifest_version": 3,
    "permissions": ["contextMenus", "scripting", "tabs"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Selected Text"
    }
  }
  