{
  "name": "YouTube Video Finder",
  "version": "1.2",
  "description": "Right-click selected text to find related YouTube videos with timestamps.",
  "manifest_version": 3,
  "permissions": ["contextMenus", "scripting", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://*.youtube.com/*",
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Video Finder"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
